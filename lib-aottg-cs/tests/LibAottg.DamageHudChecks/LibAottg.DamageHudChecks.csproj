<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LibAottg.Core/LibAottg.Core.csproj" />
    <ProjectReference Include="../../src/LibAottg.Assets/LibAottg.Assets.csproj" />
    <Content Include="fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/ui/aottg-damage-score/*.png;../../assets/ui/aottg-damage-score/manifest.json"
             Link="DamageHudPackage/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
