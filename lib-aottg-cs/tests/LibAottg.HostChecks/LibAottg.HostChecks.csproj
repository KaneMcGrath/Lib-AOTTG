<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(PortableHost)' == 'true'">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LibAottg.Core/LibAottg.Core.csproj" />
    <ProjectReference Include="../../src/LibAottg.Assets/LibAottg.Assets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../assets/effects/smoke/manifest.json;../../assets/effects/smoke/smoke.png"
             Link="SmokePackage/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
